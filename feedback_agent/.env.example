GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
GOOGLE_API_KEY="YOUR-API-KEY"

# ============================================================================
# Model Configuration (REQUIRED)
# ============================================================================
# This controls which Gemini model all agents use. Change this to manage
# API quotas and performance tradeoffs.
#
# Available Models (Free Tier Rate Limits):
# - gemini-2.0-flash:     15 requests/min
# - gemini-2.5-flash:     10 requests/min
# - gemini-2.5-pro:       2 requests/min, best quality, very restricted
#
# Recommendation: Use gemini-1.5-flash for evaluation runs (best rate limit)
# ============================================================================
MODEL_NAME="gemini-2.5-flash"
